# Secrets. The globs cover loose key files that tend to land in the project
# root, not just .env — one slipped into a commit and had to be stripped out.
.env
key-*.txt
*.pem
*.p12
*.jks
credentials*.json

# Editor and local tooling state
.claude/
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# Build artifacts — phát hành qua GitHub Releases, không đưa vào Git
*.apk
*.zip
*.docx

# Trung gian của quá trình training — sinh lại được từ training/finetune_cadebot.py
cadebot-lora/checkpoint-*/
cadebot-merged/
*.gguf

# Báo cáo tự sinh
PIPELINE_ANALYSIS.html
PIPELINE_ANALYSIS_files/
