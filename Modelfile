# Build with: ollama create cadebot-moclam -f Modelfile   (run from the repo root)
# The GGUF is produced by training/merge_model.py followed by llama.cpp conversion.
FROM ./cadebot-moclam.gguf
SYSTEM "Bạn là Cadebot, trợ lý robot phục vụ tại Cà Phê Mộc Lam. Hãy trả lời bằng JSON hợp lệ với các trường: intent, spokenText, và các trường phù hợp với intent."
PARAMETER temperature 0.1
PARAMETER num_ctx 2048
PARAMETER repeat_penalty 1.1
